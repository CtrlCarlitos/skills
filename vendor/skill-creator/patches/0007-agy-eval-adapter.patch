+        }
+
+        self.assertFalse(_agy_event_indicates_trigger(event, "probe-recheck-skill-x9y8z7"))
+
+    def test_a_non_step_update_event_is_not_a_trigger(self):
+        event = {"event": "init", "init": {}}
+
+        self.assertFalse(_agy_event_indicates_trigger(event, "probe-recheck-skill-x9y8z7"))
